---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { data } = project;
---

<article class="project-card" style={`--delay:${Math.min(index * 55, 330)}ms`}>
  <a class="project-card__image" href={withBase(`/projects/${project.id}/`)}>
    <img src={withBase(data.cover)} alt={`Проект «${data.title}»`} loading={index > 1 ? 'lazy' : 'eager'} />
  </a>
  <div class="project-card__meta">
    <div>
      <h2><a href={withBase(`/projects/${project.id}/`)}>{data.title}</a></h2>
      <p>{data.category} · {data.location}</p>
    </div>
    <span>{data.year}</span>
  </div>
</article>
