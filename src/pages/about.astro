---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { withBase } from '../lib/paths';
---

<BaseLayout title="О дизайнере — Madik Studio" description={site.aboutText}>
  <section class="page-intro shell">
    <p class="eyebrow">Студия</p>
    <h1>О дизайнере</h1>
  </section>
  <section class="about shell">
    <figure class="about__portrait">
      <img src={withBase('/images/placeholders/portrait.svg')} alt="Портрет дизайнера Madik Studio" />
    </figure>
    <div class="about__content">
      <h2>{site.aboutTitle}</h2>
      <p>{site.aboutText}</p>
      <div class="about__principles">
        <p><span>01</span> Ясная пространственная логика</p>
        <p><span>02</span> Материалы, которые красиво стареют</p>
        <p><span>03</span> Спокойная выразительность вместо декора ради декора</p>
      </div>
    </div>
  </section>
</BaseLayout>
